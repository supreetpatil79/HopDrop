NODE_ENV=development
PORT=5000
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000
MAX_CONNECTIONS=2000
MAX_IN_FLIGHT_REQUESTS=1000
FRONTEND_URL=http://localhost,http://localhost:3001,http://localhost:3002
# Required in production even though a local default exists.
INTERNAL_API_TOKEN=hopdrop-local-internal-token
LOG_LEVEL=info
REQUIRE_HTTPS=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
OTEL_ENABLED=false
OTEL_SERVICE_NAME=hopdrop-core-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
BULL_BOARD_PASSWORD=change-this-local-queues-password

# MongoDB
MONGODB_URI=mongodb://localhost:27017,localhost:27018,localhost:27019/hopdrop?replicaSet=rs0

# Redis (required in production; keep cache and queue URLs separate)
REDIS_CACHE_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380
# Backward-compatible dev fallback only. Prefer the two explicit URLs above.
REDIS_URL=redis://localhost:6379
REALTIME_EVENT_CHANNEL=hopdrop:realtime:events
ROUTING_SEARCH_URL=http://localhost:8010
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=hopdrop-core-api
KAFKA_TOPIC_PREFIX=hopdrop
SEARCH_INDEXER_PORT=5003
SEARCH_INDEXER_LOG_LEVEL=info
MATCHING_ORCHESTRATOR_PORT=5004
MATCHING_ORCHESTRATOR_LOG_LEVEL=info
NOTIFICATION_CONSUMER_PORT=5005
NOTIFICATION_CONSUMER_LOG_LEVEL=info
ANALYTICS_PIPELINE_PORT=5006
ANALYTICS_PIPELINE_LOG_LEVEL=info
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=8

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-minimum-64-characters-long-for-local-dev-only
JWT_REFRESH_SECRET=change-me-refresh-secret-minimum-64-characters-long-for-local-dev-only
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
DEMO_MODE=true

# OTP — MSG91
MSG91_AUTH_KEY=your-msg91-key
MSG91_TEMPLATE_ID=your-template-id

# MapMyIndia
MMI_CLIENT_ID=your-mmi-client-id
MMI_CLIENT_SECRET=your-mmi-client-secret
MMI_REST_API_KEY=your-mmi-rest-key
ROUTING_SEARCH_LOG_LEVEL=INFO
ROUTING_SEARCH_SENTRY_DSN=
ROUTING_SEARCH_SENTRY_TRACES_SAMPLE_RATE=0.1

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
VITE_RAZORPAY_KEY_ID=rzp_test_xxx

# Rapido
RAPIDO_API_KEY=your-rapido-key
RAPIDO_ENV=sandbox

# Cloudinary (package photo uploads)
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# Platform Config
PLATFORM_FEE_PERCENT=12
DEFAULT_SAFETY_DEPOSIT_PAISE=50000
ESCROW_RELEASE_DELAY_MS=7200000
# Pricing engine notes:
# - Carrier payout is calculated separately from sender platform fees.
# - Safety deposits are paise and scale with declared package value, capped at Rs 5,000.

# Frontend telemetry
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
VITE_SENTRY_DSN=
VITE_APP_ENV=development
VITE_RELEASE=local
VITE_ANALYTICS_DEBUG=false
