# Sender Portal — Environment Variables
# Copy to .env.local for local development
# For Vercel: set these as Environment Variables in the Vercel dashboard

# API endpoint — your backend URL (no trailing slash)
VITE_API_URL=http://localhost

# WebSocket / Socket.IO URL
VITE_SOCKET_URL=http://localhost

# MapMyIndia map SDK key (client ID)
VITE_MMI_KEY=your-mmi-client-id

# Razorpay publishable key (safe to expose in frontend)
VITE_RAZORPAY_KEY_ID=rzp_test_xxx

# PostHog analytics (optional, leave blank to disable)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Sentry error tracking (optional, leave blank to disable)
VITE_SENTRY_DSN=

# App environment label (development | staging | production)
VITE_APP_ENV=development

# Git commit SHA or semver for Sentry release tracking
VITE_RELEASE=local

# Set to true to log analytics events to console
VITE_ANALYTICS_DEBUG=false

# Demo mode: uses mock map data without real MMI keys
# Set to false in production
VITE_DEMO_MODE=true
